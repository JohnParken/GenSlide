# ==============================================================================
# tl-proxy configuration
# ==============================================================================

# Server Network Binding
TL_PROXY_HOST=127.0.0.1
TL_PROXY_PORT=8089

# Upstream Provider ("qwen" or "deepseek")
UPSTREAM_PROVIDER=qwen
UPSTREAM_MODEL=qwen3.8-flash
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_API_KEY=sk-your-dashscope-key-here

# Upstream Thinking Parameter ("provider-default" | "enabled" | "disabled")
UPSTREAM_THINKING=provider-default

# Logging Level ("debug" | "info" | "warn" | "error")
# Defaults to "debug" for complete 4-direction transparent message tracking
LOG_LEVEL=debug

# Protocol Variables
SYSTEM_PROMPT_VARIABLE_NAME=system_prompt
LEGACY_ROLE_TEXT=true

# Authentication Mode ("local" | "bearer")
# In local mode, no credentials are required to call proxy
# In bearer mode, caller must send "Authorization: Bearer <TEST_ACCESS_TOKEN>"
AUTH_MODE=local
TEST_ACCESS_TOKEN=

# Timeouts and Limits
UPSTREAM_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=30000
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=4194304
MAX_UPSTREAM_WIRE_BYTES=67108864
MAX_DOWNSTREAM_WIRE_BYTES=67108864
MAX_SSE_EVENT_BYTES=262144
SESSION_TTL_MS=900000
MAX_SESSIONS=10000
MAX_INFLIGHT_REQUESTS=32
CORS_ALLOWED_ORIGINS=
