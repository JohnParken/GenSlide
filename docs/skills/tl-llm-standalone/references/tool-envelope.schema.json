{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QwenPaw TL prompt output v1 (model body only)",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "final"
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "version",
        "type",
        "calls"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "tool_calls"
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": [
              "name",
              "arguments"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "arguments": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
