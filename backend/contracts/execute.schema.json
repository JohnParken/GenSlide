{
  "additionalProperties": false,
  "properties": {
    "api_contract_version": {
      "const": "1",
      "default": "1",
      "title": "Api Contract Version",
      "type": "string"
    },
    "engine": {
      "const": "agentscope",
      "title": "Engine",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "user_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "runtime_epoch": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Runtime Epoch",
      "type": "string"
    },
    "action_id": {
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "title": "Action Id",
      "type": "string"
    },
    "authorization": {
      "format": "password",
      "title": "Authorization",
      "type": "string",
      "writeOnly": true
    },
    "expected_session_version": {
      "minimum": 0,
      "title": "Expected Session Version",
      "type": "integer"
    },
    "expected_lifecycle_version": {
      "minimum": 1,
      "title": "Expected Lifecycle Version",
      "type": "integer"
    },
    "mode": {
      "const": "assistant",
      "default": "assistant",
      "title": "Mode",
      "type": "string"
    },
    "message": {
      "default": "",
      "maxLength": 16000,
      "title": "Message",
      "type": "string"
    },
    "current_file_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Current File Ids",
      "type": "array"
    },
    "requested_output": {
      "default": "auto",
      "enum": [
        "auto",
        "text",
        "document",
        "presentation"
      ],
      "title": "Requested Output",
      "type": "string"
    },
    "requested_skill_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Skill Id"
    }
  },
  "required": [
    "engine",
    "tenant_id",
    "user_id",
    "session_id",
    "runtime_epoch",
    "action_id",
    "authorization",
    "expected_session_version",
    "expected_lifecycle_version"
  ],
  "title": "ExecuteRequest",
  "type": "object"
}
